{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "value": "northeurope" },
    "staticWebAppLocation": { "value": "westeurope" },
    "staticWebAppName": { "value": "replace-with-globally-unique-portfolio-web" },
    "apiAppName": { "value": "replace-with-globally-unique-portfolio-api" },
    "sqlServerName": { "value": "replace-with-globally-unique-portfolio-sql" },
    "appServicePlanSku": { "value": "F1" },
    "staticWebAppSku": { "value": "Free" },
    "deploySql": { "value": false },
    "deployKeyVault": { "value": false },
    "deployMonitoring": { "value": false },
    "allowAzureServicesToSql": { "value": false },
    "logAnalyticsRetentionInDays": { "value": 30 },
    "tags": {
      "value": {
        "application": "portfolio",
        "environment": "development",
        "managedBy": "bicep"
      }
    }
  }
}
