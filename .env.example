# Frontend build/runtime
PORTFOLIO_API_URL=http://localhost:5050
FRONTEND_API_URL=[ADD PUBLIC API URL]
FRONTEND_ORIGIN=[ADD PUBLIC FRONTEND ORIGIN]
CONTACT_HASH_SALT=[ADD UNIQUE SECRET OF AT LEAST 32 CHARACTERS]

# Backend
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5050
Database__Provider=Sqlite
Database__ApplyMigrationsOnStartup=false
ConnectionStrings__Portfolio=Data Source=/app/data/portfolio.db
Cors__AllowedOrigins__0=http://localhost:4200
Contact__HashSalt=[ADD LOCAL NON-PRODUCTION HASH SALT]
ReverseProxy__TrustForwardedHeaders=false
ApplicationInsights__ConnectionString=

# Deployment placeholders - do not add secrets here
AZURE_SUBSCRIPTION_ID=[ADD AZURE SUBSCRIPTION ID]
AZURE_TENANT_ID=[ADD AZURE TENANT ID]
AZURE_CLIENT_ID=[ADD FEDERATED IDENTITY CLIENT ID]
AZURE_RESOURCE_GROUP=[ADD RESOURCE GROUP]
